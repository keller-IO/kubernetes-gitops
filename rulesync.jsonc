{
  "$schema": "https://github.com/dyoshikawa/rulesync/releases/latest/download/config-schema.json",

  // Single source of truth lives in .rulesync/; the tool-native files are
  // generated and gitignored (see .gitignore). Regenerate with `just agents-setup`.
  "targets": ["claudecode", "codexcli", "cursor", "opencode"],

  "features": ["rules", "subagents", "skills", "permissions"],

  "outputRoots": ["."],

  // Remove Rulesync-managed files it no longer writes before regenerating.
  "delete": true,

  // `rulesync gitignore` only emits entries for the configured targets.
  "gitignoreTargetsOnly": true,

  "verbose": false,
  "silent": false,
  "global": false
}
