{
  // Runtime enforcement of the Agent Safety rule (rules/overview.md) and
  // docs/learnings/agent-command-guardrails.md: an agent may inspect the live
  // cluster read-only, but must not mutate it. rulesync turns these into native
  // permission rules per tool — Claude Code `Bash(<pattern>)`, OpenCode
  // `permission.bash`, Cursor `Shell(<pattern>)` and Codex `prefix_rule(...)`.
  // A deny always outranks an allow; read-only verbs are left untouched.
  //
  // Patterns are deliberately the lowest common denominator: `<tool> <verb> *`
  // (literal words plus a trailing wildcard). Codex matches each word as a
  // literal token and cannot translate a glob inside or before a word
  // (`kubectl delete*`, `kubectl -* delete *`), so such patterns are dropped
  // there — and a dropped deny is no protection. Keeping every entry in this
  // shape means all four tools enforce the same list.
  //
  // Residual gap: global flags *before* the verb (`kubectl -n prod delete pod x`,
  // `helm -n x upgrade`) cannot be expressed as a Codex prefix, so no tool is
  // given that rule. The real control remains the read-only kubeconfig; this
  // list is defence in depth.
  "permission": {
    "bash": {
      // kubectl — mutating verbs
      "kubectl apply *": "deny",
      "kubectl create *": "deny",
      "kubectl replace *": "deny",
      "kubectl delete *": "deny",
      "kubectl patch *": "deny",
      "kubectl edit *": "deny",
      "kubectl scale *": "deny",
      "kubectl label *": "deny",
      "kubectl annotate *": "deny",
      "kubectl set *": "deny",
      "kubectl drain *": "deny",
      "kubectl cordon *": "deny",
      "kubectl uncordon *": "deny",
      "kubectl taint *": "deny",
      "kubectl rollout *": "deny",
      "kubectl cp *": "deny",

      // oc — mutating verbs
      "oc apply *": "deny",
      "oc create *": "deny",
      "oc replace *": "deny",
      "oc delete *": "deny",
      "oc patch *": "deny",
      "oc edit *": "deny",
      "oc scale *": "deny",
      "oc label *": "deny",
      "oc annotate *": "deny",
      "oc set *": "deny",
      "oc drain *": "deny",
      "oc cordon *": "deny",
      "oc uncordon *": "deny",
      "oc taint *": "deny",
      "oc rollout *": "deny",
      "oc cp *": "deny",

      // talosctl — node/cluster mutation
      "talosctl apply-config *": "deny",
      "talosctl patch *": "deny",
      "talosctl upgrade *": "deny",
      "talosctl bootstrap *": "deny",
      "talosctl drain *": "deny",
      "talosctl reboot *": "deny",
      "talosctl reset *": "deny",
      "talosctl maintenance *": "deny",
      "talosctl service *": "deny",
      "talosctl etcd *": "deny",
      "talosctl config *": "deny",

      // helm — release mutation
      "helm install *": "deny",
      "helm upgrade *": "deny",
      "helm uninstall *": "deny",
      "helm rollback *": "deny",

      // argocd — application mutation
      "argocd app sync *": "deny",
      "argocd app set *": "deny",
      "argocd app create *": "deny",
      "argocd app delete *": "deny",
      "argocd app prune *": "deny",
      "argocd app rotate *": "deny",
      "argocd app undelete *": "deny"
    }
  },
  // Routine diagnosis via the read-only Kubernetes MCP server. Exact tool
  // names match kubernetes-mcp-server v0.0.61. Server --read-only and RBAC
  // remain the cluster access boundary. Codex approvals live in mcp.jsonc.
  "claudecode": {
    "permission": {
      "mcp__keller-kubernetes__namespaces_list": { "*": "allow" },
      "mcp__keller-kubernetes__events_list": { "*": "allow" },
      "mcp__keller-kubernetes__pods_list": { "*": "allow" },
      "mcp__keller-kubernetes__pods_list_in_namespace": { "*": "allow" },
      "mcp__keller-kubernetes__pods_get": { "*": "allow" },
      "mcp__keller-kubernetes__pods_log": { "*": "allow" },
      "mcp__keller-kubernetes__resources_list": { "*": "allow" },
      "mcp__keller-kubernetes__resources_get": { "*": "allow" }
    }
  },
  "cursor": {
    "permission": {
      "mcp__keller-kubernetes__namespaces_list": { "*": "allow" },
      "mcp__keller-kubernetes__events_list": { "*": "allow" },
      "mcp__keller-kubernetes__pods_list": { "*": "allow" },
      "mcp__keller-kubernetes__pods_list_in_namespace": { "*": "allow" },
      "mcp__keller-kubernetes__pods_get": { "*": "allow" },
      "mcp__keller-kubernetes__pods_log": { "*": "allow" },
      "mcp__keller-kubernetes__resources_list": { "*": "allow" },
      "mcp__keller-kubernetes__resources_get": { "*": "allow" }
    }
  },
  "opencode": {
    "permission": {
      // OpenCode defaults to allow; prompt for other tools from this server.
      "keller-kubernetes_*": "ask",
      "keller-kubernetes_namespaces_list": "allow",
      "keller-kubernetes_events_list": "allow",
      "keller-kubernetes_pods_list": "allow",
      "keller-kubernetes_pods_list_in_namespace": "allow",
      "keller-kubernetes_pods_get": "allow",
      "keller-kubernetes_pods_log": "allow",
      "keller-kubernetes_resources_list": "allow",
      "keller-kubernetes_resources_get": "allow"
    }
  }
}
