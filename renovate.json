{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    ":semanticCommits"
  ],
  "timezone": "Europe/Berlin",
  "labels": [
    "dependencies"
  ],
  "ignorePaths": [
    ".forgejo/**",
    "**/*.sops.yaml",
    "**/charts/**",
    "apps/vendor/**"
  ],
  "rebaseWhen": "behind-base-branch",
  "minimumReleaseAge": "7 days",
  "prHourlyLimit": 2,
  "prConcurrentLimit": 10,
  "nix": {
    "enabled": true
  },
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true
  },
  "kustomize": {
    "managerFilePatterns": [
      "/(^|/)(apps|infrastructure|clusters)/.+/kustomization\\.ya?ml$/"
    ]
  },
  "kubernetes": {
    "managerFilePatterns": [
      "/(^|/)(apps|infrastructure|clusters)/.+\\.ya?ml$/"
    ]
  },
  "github-actions": {
    "managerFilePatterns": [
      "/(^|/)\\.github/workflows/.+\\.ya?ml$/"
    ]
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Generic marker '# renovate: datasource=X depName=Y [versioning=Z]' for fields without native manager support.",
      "managerFilePatterns": [
        "/(^|/)(apps|infrastructure|clusters)/.+\\.ya?ml$/"
      ],
      "matchStrings": [
        "#\\s*renovate:\\s*datasource=(?<datasource>\\S+)\\s+depName=(?<depName>\\S+)(?:\\s+packageName=(?<packageName>\\S+))?(?:\\s+versioning=(?<versioning>\\S+))?\\s*\\n(?:[^\\n]*\\n)*?\\s*tag:\\s*[\"']?(?<currentValue>[^\\s\"'#]+)[\"']?",
        "\\sversion:\\s*[\"']?(?<currentValue>[^\\s\"'#]+)[\"']?\\s*#\\s*renovate:\\s*datasource=(?<datasource>\\S+)\\s+depName=(?<depName>\\S+)(?:\\s+packageName=(?<packageName>\\S+))?(?:\\s+versioning=(?<versioning>\\S+))?"
      ],
      "versioningTemplate": "{{#if versioning}}{{{versioning}}}{{else}}semver{{/if}}"
    },
    {
      "customType": "regex",
      "description": "Legacy repo marker '# renovate: image=repo/name' for inline images and tag-only values.",
      "managerFilePatterns": [
        "/(^|/)(apps|infrastructure|clusters)/.+\\.ya?ml$/"
      ],
      "matchStrings": [
        "tag:\\s*[\"']?(?<currentValue>[^\\s\"'#]+)[\"']?\\s*#\\s*renovate:\\s*image=(?<depName>\\S+)"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "loose"
    },
    {
      "customType": "regex",
      "description": "CNPG imageName is not supported by the Kubernetes manager. Preserve tags and digests together.",
      "managerFilePatterns": [
        "/(^|/)(apps|infrastructure|clusters)/.+\\.ya?ml$/"
      ],
      "matchStrings": [
        "\\bimageName:\\s*[\"']?(?<depName>[^\\s:@\"']+):(?<currentValue>[^\\s@\"'#]+)(?:@(?<currentDigest>sha256:[a-f0-9]{64}))?"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "Legacy digest-only image markers keep manifests non-floating while allowing digest refreshes.",
      "managerFilePatterns": [
        "/(^|/)(apps|infrastructure|clusters)/.+\\.ya?ml$/"
      ],
      "matchStrings": [
        "#\\s*renovate:\\s*image=(?<depName>\\S+)\\s*\\n\\s*(?:-\\s+)?image:\\s*[\"']?[^:@\\s\"']+@(?<currentDigest>sha256:[a-f0-9]{64})[\"']?"
      ],
      "datasourceTemplate": "docker",
      "currentValueTemplate": "latest"
    },
    {
      "customType": "regex",
      "description": "Workflow env-var marker '# renovate: datasource=X depName=Y' followed by VERSION: X.",
      "managerFilePatterns": [
        "/(^|/)\\.github/workflows/.+\\.ya?ml$/"
      ],
      "matchStrings": [
        "#\\s*renovate:\\s*datasource=(?<datasource>\\S+)\\s+depName=(?<depName>\\S+)(?:\\s+packageName=(?<packageName>\\S+))?(?:\\s+versioning=(?<versioning>\\S+))?\\s*\\n\\s*[A-Z0-9_]+:\\s*[\"']?(?<currentValue>[^\"'\\s]+)[\"']?"
      ],
      "versioningTemplate": "{{#if versioning}}{{{versioning}}}{{else}}semver{{/if}}"
    }
  ],
  "packageRules": [
    {
      "description": "Group each application across base, overlays and nested directories.",
      "matchFileNames": [
        "apps/base/**",
        "apps/overlays/**"
      ],
      "groupName": "{{{replace \"^apps/(?:base|overlays/[^/]+)/([^/]+)/.*$\" \"apps/$1\" packageFile}}}"
    },
    {
      "description": "Group each infrastructure component across base, overlays and nested directories.",
      "matchFileNames": [
        "infrastructure/base/**",
        "infrastructure/overlays/**"
      ],
      "groupName": "{{{replace \"^infrastructure/(?:base|overlays/[^/]+)/([^/]+)/.*$\" \"infrastructure/$1\" packageFile}}}"
    },
    {
      "matchFileNames": [
        "clusters/**"
      ],
      "groupName": "clusters/{{parentDir}}"
    },
    {
      "matchFileNames": [
        ".github/workflows/**"
      ],
      "groupName": "github-actions"
    },
    {
      "description": "Goloom uses a vendored chart without a Helm repository; only its application image is updated.",
      "matchManagers": [
        "kustomize"
      ],
      "matchDatasources": [
        "helm"
      ],
      "matchFileNames": [
        "apps/base/goloom/kustomization.yaml"
      ],
      "enabled": false
    },
    {
      "description": "Nix flake inputs are grouped and automerged after the global soak period.",
      "matchManagers": [
        "nix"
      ],
      "groupName": "nix packages",
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": true
    },
    {
      "description": "Automerge low-risk digest, pin and patch updates after CI.",
      "matchUpdateTypes": [
        "digest",
        "pin",
        "patch"
      ],
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": true
    },
    {
      "description": "Automerge minor updates only for stateless leaf apps.",
      "matchFileNames": [
        "apps/base/collabora/**",
        "apps/base/gatus/**",
        "apps/base/icecast/**",
        "apps/base/phpmyadmin/**",
        "infrastructure/base/kite/**",
        "infrastructure/base/kubernetes-mcp/**"
      ],
      "matchUpdateTypes": [
        "minor"
      ],
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": true
    },
    {
      "description": "Renovate self-updates get a shorter soak to keep the updater current.",
      "matchFileNames": [
        "apps/base/renovate/**"
      ],
      "minimumReleaseAge": "2 days",
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": true
    },
    {
      "description": "Infrastructure controllers and stateful applications need manual review.",
      "matchFileNames": [
        "apps/base/forgejo/**",
        "apps/base/kimai/**",
        "apps/base/mailman/**",
        "apps/base/mastodon/**",
        "apps/base/paperless-ngx/**",
        "apps/base/roundcube/**",
        "apps/base/wordpress/**",
        "infrastructure/base/argocd/**",
        "infrastructure/base/authentik/**",
        "infrastructure/base/ceph-csi/**",
        "infrastructure/base/cert-manager/**",
        "infrastructure/base/cilium/**",
        "infrastructure/base/cnpg/**",
        "infrastructure/base/ingress-nginx/**",
        "infrastructure/base/mariadb-operator/**",
        "infrastructure/base/monitoring/**",
        "apps/base/ciso-assistant/**",
        "apps/base/expense-tracker/**",
        "apps/base/matomo/**",
        "infrastructure/base/crowdsec/**",
        "infrastructure/base/csi-driver-smb/**",
        "infrastructure/base/netbird/**",
        "infrastructure/base/snapshot-controller/**"
      ],
      "automerge": false
    },
    {
      "description": "0.x minor updates can be breaking; keep them manual.",
      "matchUpdateTypes": [
        "minor"
      ],
      "matchCurrentVersion": "/^0\\./",
      "automerge": false
    },
    {
      "matchPackageNames": [
        "kimai/kimai2"
      ],
      "versioning": "regex:^(?<compatibility>apache)-(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)$"
    },
    {
      "description": "Commit-SHA deployments are released by the application pipeline, not ordered Docker tags.",
      "matchPackageNames": [
        "registry.jit-creatives.de/jit/expense-tracker"
      ],
      "enabled": false
    },
    {
      "description": "Mailman images are intentionally frozen during migration (renovate: ignore is not a native directive).",
      "matchFileNames": [
        "apps/base/mailman/workload.yaml"
      ],
      "matchPackageNames": [
        "maxking/mailman-core",
        "maxking/mailman-web"
      ],
      "enabled": false
    },
    {
      "description": "CNPG Postgres 16: patch/build updates only; major upgrades require a migration.",
      "matchPackageNames": [
        "ghcr.io/cloudnative-pg/postgresql"
      ],
      "matchCurrentVersion": "/^16\\./",
      "allowedVersions": "/^16\\.\\d+(?:-|$)/",
      "automerge": false
    },
    {
      "description": "CNPG Postgres 17: patch/build updates only; major upgrades require a migration.",
      "matchPackageNames": [
        "ghcr.io/cloudnative-pg/postgresql"
      ],
      "matchCurrentVersion": "/^17\\./",
      "allowedVersions": "/^17\\.\\d+(?:-|$)/",
      "automerge": false
    },
    {
      "description": "Kustomize release tags contain a component prefix; ignore kyaml and api releases.",
      "matchDatasources": [
        "github-releases"
      ],
      "matchPackageNames": [
        "kubernetes-sigs/kustomize"
      ],
      "extractVersion": "^kustomize/v(?<version>.+)$"
    },
    {
      "description": "CNPG timestamped system images: compare build dates as versions while keeping the OS variant compatible.",
      "matchPackageNames": [
        "ghcr.io/cloudnative-pg/postgresql"
      ],
      "matchCurrentValue": "/-\\d+-system-/",
      "versioning": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)-(?<build>\\d+)-(?<compatibility>system-[a-z0-9-]+)$"
    }
  ]
}
