{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommits",
    "customManagers:githubActionsVersions"
  ],
  "timezone": "Europe/Berlin",
  "labels": [
    "dependencies"
  ],
  "ignorePaths": [
    ".forgejo/**",
    "**/*.sops.yaml",
    "**/charts/**"
  ],
  "rebaseWhen": "behind-base-branch",
  "minimumReleaseAge": "7 days",
  "nix": {
    "enabled": true
  },
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true
  },
  "kubernetes": {
    "managerFilePatterns": [
      "{apps,infrastructure,clusters}/**/*.{yaml,yml}"
    ]
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Tag-only Helm values with '# renovate: image=repo/name'.",
      "managerFilePatterns": [
        "{apps,infrastructure,clusters}/**/*.{yaml,yml}"
      ],
      "matchStrings": [
        "tag:\\s*[\"']?(?<currentValue>[^\\s\"'#]+)[\"']?\\s*#\\s*renovate:\\s*image=(?<depName>\\S+)"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "loose"
    },
    {
      "customType": "regex",
      "description": "CNPG imageName is not supported by the Kubernetes manager. Preserve tags and digests together.",
      "managerFilePatterns": [
        "{apps,infrastructure,clusters}/**/*.{yaml,yml}"
      ],
      "matchStrings": [
        "\\bimageName:\\s*[\"']?(?<depName>[^\\s:@\"']+):(?<currentValue>[^\\s@\"'#]+)(?:@(?<currentDigest>sha256:[a-f0-9]{64}))?"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "Talos SUC Plan version and explicit installer tag track the same Talos release.",
      "managerFilePatterns": [
        "infrastructure/base/system-upgrade-controller/talos-plan.yaml"
      ],
      "matchStrings": [
        "version:\\s*(?<currentValue>v\\d+\\.\\d+\\.\\d+)\\s+# renovate: datasource=github-releases depName=siderolabs/talos",
        "--image=factory\\.talos\\.dev/nocloud-installer/[a-f0-9]{64}:(?<currentValue>v\\d+\\.\\d+\\.\\d+)"
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "siderolabs/talos",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "SUC generated drain image lives in a ConfigMap string, outside the Kubernetes image extractor.",
      "managerFilePatterns": [
        "infrastructure/base/system-upgrade-controller/patch-controller.yaml"
      ],
      "matchStrings": [
        "SYSTEM_UPGRADE_JOB_KUBECTL_IMAGE:\\s*[\\\"\\']?(?<depName>rancher/kubectl):(?<currentValue>v\\d+\\.\\d+\\.\\d+)"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    }
  ],
  "packageRules": [
    {
      "description": "Group charts, images and markers per component across base, overlays and subdirectories.",
      "matchFileNames": [
        "apps/base/**",
        "apps/overlays/**",
        "infrastructure/base/**",
        "infrastructure/overlays/**"
      ],
      "groupName": "{{{replace \"^(apps|infrastructure)/(?:base|overlays/[^/]+)/([^/]+)/.*$\" \"$1/$2\" packageFile}}}"
    },
    {
      "matchFileNames": [
        "clusters/**"
      ],
      "groupName": "clusters/{{parentDir}}"
    },
    {
      "matchFileNames": [
        ".github/workflows/**"
      ],
      "groupName": "github-actions"
    },
    {
      "description": "Group the Goloom chart and image; GitHub releases supply dates for the seven-day release age.",
      "groupName": "apps/goloom",
      "overrideDatasource": "github-releases",
      "overridePackageName": "Goloom-App/goloom",
      "matchDepNames": [
        "https://github.com/Goloom-App/goloom"
      ]
    },
    {
      "description": "Nix flake inputs are grouped and automerged after the global soak period.",
      "matchManagers": [
        "nix"
      ],
      "groupName": "nix packages",
      "automerge": true
    },
    {
      "description": "Automerge low-risk digest, pin and patch updates after CI.",
      "matchUpdateTypes": [
        "digest",
        "pin",
        "patch"
      ],
      "automerge": true
    },
    {
      "description": "Automerge minor updates only for stateless leaf apps.",
      "matchFileNames": [
        "apps/base/collabora/**",
        "apps/base/gatus/**",
        "apps/base/icecast/**",
        "apps/base/phpmyadmin/**",
        "infrastructure/base/kite/**",
        "infrastructure/base/kubernetes-mcp/**"
      ],
      "matchUpdateTypes": [
        "minor"
      ],
      "automerge": true
    },
    {
      "description": "Renovate self-updates get a shorter soak to keep the updater current.",
      "matchFileNames": [
        "apps/base/renovate/**"
      ],
      "minimumReleaseAge": "2 days",
      "automerge": true
    },
    {
      "description": "Infrastructure controllers and stateful applications need manual review.",
      "matchFileNames": [
        "apps/base/forgejo/**",
        "apps/base/kimai/**",
        "apps/base/mailman/**",
        "apps/base/mastodon/**",
        "apps/base/paperless-ngx/**",
        "apps/base/roundcube/**",
        "apps/base/wordpress/**",
        "infrastructure/base/argocd/**",
        "infrastructure/base/authentik/**",
        "infrastructure/base/ceph-csi/**",
        "infrastructure/base/cert-manager/**",
        "infrastructure/base/cilium/**",
        "infrastructure/base/cnpg/**",
        "infrastructure/base/ingress-nginx/**",
        "infrastructure/base/mariadb-operator/**",
        "infrastructure/base/monitoring/**",
        "apps/base/ciso-assistant/**",
        "apps/base/expense-tracker/**",
        "apps/base/matomo/**",
        "infrastructure/base/crowdsec/**",
        "infrastructure/base/csi-driver-smb/**",
        "infrastructure/base/netbird/**",
        "infrastructure/base/snapshot-controller/**"
      ],
      "automerge": false
    },
    {
      "description": "0.x minor updates can be breaking; keep them manual.",
      "matchUpdateTypes": [
        "minor"
      ],
      "matchCurrentVersion": "/^0\\./",
      "automerge": false
    },
    {
      "matchPackageNames": [
        "kimai/kimai2"
      ],
      "versioning": "regex:^(?<compatibility>apache)-(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)$"
    },
    {
      "description": "Commit-SHA deployments are released by the application pipeline, not ordered Docker tags.",
      "matchPackageNames": [
        "registry.jit-creatives.de/jit/expense-tracker"
      ],
      "enabled": false
    },
    {
      "description": "Mailman images are intentionally frozen during migration (renovate: ignore is not a native directive).",
      "matchFileNames": [
        "apps/base/mailman/workload.yaml"
      ],
      "matchPackageNames": [
        "maxking/mailman-core",
        "maxking/mailman-web"
      ],
      "enabled": false
    },
    {
      "description": "CNPG Postgres 16: patch/build updates only; major upgrades require a migration.",
      "matchPackageNames": [
        "ghcr.io/cloudnative-pg/postgresql"
      ],
      "matchCurrentVersion": "/^16\\./",
      "allowedVersions": "/^16\\.\\d+(?:-|$)/",
      "automerge": false
    },
    {
      "description": "CNPG Postgres 17: patch/build updates only; major upgrades require a migration.",
      "matchPackageNames": [
        "ghcr.io/cloudnative-pg/postgresql"
      ],
      "matchCurrentVersion": "/^17\\./",
      "allowedVersions": "/^17\\.\\d+(?:-|$)/",
      "automerge": false
    },
    {
      "description": "Kustomize release tags contain a component prefix; ignore kyaml and api releases.",
      "matchDatasources": [
        "github-releases"
      ],
      "matchPackageNames": [
        "kubernetes-sigs/kustomize"
      ],
      "extractVersion": "^kustomize/v(?<version>.+)$"
    },
    {
      "description": "CNPG timestamped system images: compare build dates as versions while keeping the OS variant compatible.",
      "matchPackageNames": [
        "ghcr.io/cloudnative-pg/postgresql"
      ],
      "matchCurrentValue": "/-\\d+-system-/",
      "versioning": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)-(?<build>\\d+)-(?<compatibility>system-[a-z0-9-]+)$"
    },
    {
      "description": "SUC runtime, preflight Python and kubectl updates require manual review.",
      "matchFileNames": [
        "infrastructure/base/system-upgrade-controller/**"
      ],
      "automerge": false
    },
    {
      "description": "Talos CLI uses release dates and versions from the same source as Plan/installer.",
      "matchFileNames": [
        "infrastructure/base/system-upgrade-controller/**"
      ],
      "matchPackageNames": [
        "ghcr.io/siderolabs/talosctl"
      ],
      "overrideDatasource": "github-releases",
      "overridePackageName": "siderolabs/talos"
    },
    {
      "description": "Keep Plan, talosctl and installer in one patch release on the reviewed 1.13 line; advancing a minor requires a separate reviewed compatibility change.",
      "matchFileNames": [
        "infrastructure/base/system-upgrade-controller/**"
      ],
      "matchPackageNames": [
        "siderolabs/talos",
        "ghcr.io/siderolabs/talosctl"
      ],
      "groupName": "infrastructure/talos",
      "allowedVersions": "/^v?1\\.13\\.\\d+$/",
      "minimumReleaseAge": "7 days",
      "automerge": false
    },
    {
      "description": "Automerge Talos patches only after seven days and required CI; component defaults keep every other upgrade manual.",
      "matchFileNames": [
        "infrastructure/base/system-upgrade-controller/**"
      ],
      "matchPackageNames": [
        "siderolabs/talos",
        "ghcr.io/siderolabs/talosctl"
      ],
      "matchUpdateTypes": [
        "patch"
      ],
      "automerge": true
    }
  ],
  "argocd": {
    "managerFilePatterns": [
      "clusters/main/appset-apps.yaml"
    ]
  }
}
