# Produktion. Zugangsdaten und Endpunkte in secret.sops.yaml.
# Per configMapGenerator: der Name traegt einen Hash, jede Aenderung rollt das
# Deployment neu aus (envFrom liest nur beim Start).
ENVIRONMENT=production
DEBUG=0
DJANGO_ALLOWED_HOSTS=www.jit-creatives.de www.jitcreatives.de jitmgmt.jit.services localhost 127.0.0.1
CSRF_TRUSTED_ORIGINS=https://www.jit-creatives.de,https://www.jitcreatives.de,https://jitmgmt.jit.services
TRUST_X_FORWARDED_PROTO=1
LOG_LEVEL=INFO
HOME=/tmp
INVOICE_STORAGE=s3
INVOICE_S3_BUCKET=invoices
INVOICE_S3_REGION=us-east-1
MAIL_ENABLED=1
# Mahngebuehr in Euro fuer Gewerbekunden, Mahnung 32 Tage nach Zustellung (CronJob mahnlauf);
# Privatkunden werden ohne Gebuehr gemahnt
DUNNING_FEE=1.50
EMAIL_PORT=587
PAYPAL_MODE=live
PAYPAL_SITE_URL=https://www.jit-creatives.de
MATOMO_PROXY_URL=https://matomo.jit.services
JITIX_REMOTE_ENABLED=1
# Schluessel kopiert der initContainer prepare-secrets mit passenden Rechten nach /tmp
JITIX_REMOTE_IDENTITY_FILE=/tmp/secrets/jitix_remote_ed25519
JITIX_REMOTE_KNOWN_HOSTS_FILE=/tmp/secrets/jitix_known_hosts
HETZNER_ROBOT_GPG_HOME=/tmp/gnupg
BANKING_ENABLED=0
