# Nicht-Geheimes fuer Staging; Zugangsdaten und Endpunkte in secret.sops.yaml.
# Per configMapGenerator: der Name traegt einen Hash, jede Aenderung rollt das
# Deployment neu aus (envFrom liest nur beim Start).
# Alle Integrationen nach aussen sind aus (Zahlungen nur im Testmodus); jede Mail geht nur an support@
# (MAIL_REDIRECT_TO), nie an die eigentlichen Empfaenger.
# Nur production sendet an echte Empfaenger; alles andere verlangt MAIL_REDIRECT_TO.
ENVIRONMENT=staging
DEBUG=0
# jitmgmt: interner Service-Name, unter dem der webhook-forwarder zustellt.
DJANGO_ALLOWED_HOSTS=jitmgmt-staging.jit.services jitmgmt localhost 127.0.0.1
CSRF_TRUSTED_ORIGINS=https://jitmgmt-staging.jit.services
TRUST_X_FORWARDED_PROTO=1
LOG_LEVEL=INFO
HOME=/tmp
INVOICE_STORAGE=s3
INVOICE_S3_BUCKET=invoices-staging
INVOICE_S3_REGION=us-east-1
MAIL_ENABLED=1
MAIL_REDIRECT_TO=support@jitcreatives.de
MAIL_REDIRECT_LABEL=STAGING
EMAIL_PORT=587
PAYPAL_MODE=sandbox
JITIX_REMOTE_ENABLED=0
HETZNER_ROBOT_ENABLED=0
BANKING_ENABLED=0
STRIPE_ENABLED=1
PUBLIC_BASE_URL=https://jitmgmt-staging.jit.services
