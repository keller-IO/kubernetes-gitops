# --- Secrets / SOPS / age (NEVER commit these) ---
# Private age keys
*.agekey
*.age
age.key
key.txt
keys.txt
.sops/
# Decrypted secret material (only the *.sops.yaml encrypted form belongs in git)
*.dec
*.dec.yaml
*.decrypted
*.plaintext.yaml
secret.yaml
secrets.yaml
.env
.env.*
!.env.example

# --- Kustomize / Helm render output ---
# Locally rendered manifests should not be committed
rendered/
out/
build/
*.rendered.yaml
# Helm chart caches pulled by `kustomize build --enable-helm`
charts/
Chart.lock
*.tgz
.helm/

# --- Tooling caches ---
kubeconfig
*.kubeconfig
.kube/
__pycache__/
*.py[cod]

# --- Nix ---
result
result-*
.direnv/
.envrc.local

# --- Editors / IDE ---
.idea/
.vscode/
*.swp
*.swo
*~

# --- OS ---
.DS_Store
Thumbs.db

# --- Local tooling ---
.codebase-memory/
.worktrees/

# --- Agent tool wiring (generated from .rulesync/ via `just agents-setup`) ---
# The Rulesync block below covers most generated outputs but omits these three,
# which it also manages — keep them uncommitted so .rulesync/ stays the source.
opencode.jsonc
.codex/config.toml
.claude/settings.json

# Generated by Rulesync
.rulesync/skills/.curated/
.rulesync/rules/.curated/
.rulesync/rules/*.local.md
rulesync.local.jsonc
.rulesync.local/
**/AGENTS.local.md
**/CLAUDE.local.md
**/.claude/CLAUDE.local.md
**/.claude/*.lock
**/.claude/settings.local.json
**/.claude/memories/
**/.claude/agent-memory-local/
**/.opencode/package-lock.json
**/.agents/subagents/
**/.codexignore
**/.codex/rules/rulesync.rules
**/AGENTS.md
**/.agents/memories/
**/CLAUDE.md
**/.claude/CLAUDE.md
**/.claude/rules/
**/.cursor/rules/
**/.opencode/memories/
**/.agents/commands/
**/.claude/commands/
**/.cursor/commands/
**/.opencode/commands/
**/.agents/skills/
**/.claude/skills/
**/.cursor/skills/
**/.opencode/skills/
**/.agents/agents/
**/.claude/agents/
**/.codex/agents/
**/.cursor/agents/
**/.opencode/agents/
**/.mcp.json
**/.cursor/mcp.json
**/.cursor/hooks.json
**/.codex/hooks.json
**/.opencode/plugins/rulesync-hooks.js
**/.cursor/cli.json
**/.cursorignore
!.rulesync/.aiignore
